	task.spawn(function()

		task.wait(0.15)

		NewRoom(room)

	end)

end)

--========================================================--
-- BACKUP ROOM CHECK
--========================================================--

task.spawn(function()

	while task.wait(0.5) do

		local newest = highestRoom
		local newestRoom = nil

		for _, room in ipairs(
			CurrentRooms:GetChildren()
		) do

			local number =
				GetRoomNumber(room)

			if number and number > newest then

				newest = number
				newestRoom = room

			end

		end

		if newestRoom then

			NewRoom(newestRoom)

		end

	end

end)

