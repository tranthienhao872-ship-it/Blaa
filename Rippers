local highestRoom = -1

--========================================================--
-- ROOM NUMBER
--========================================================--

local function GetRoomNumber(room)

	if not room then
		return nil
	end

	local attribute =
		room:GetAttribute("RoomNumber")

	if typeof(attribute) == "number" then

		return attribute

	end

	return tonumber(room.Name)

end

--========================================================--
-- DETECT CURRENT HIGHEST ROOM
--========================================================--

for _, room in ipairs(CurrentRooms:GetChildren()) do

	local number =
		GetRoomNumber(room)

	if number and number > highestRoom then

		highestRoom = number

	end

end

print(
	"[RIPPER] Current room:",
	highestRoom
)

--========================================================--
-- NEW ROOM
-- NO CHANCE
-- NO RANDOM ROLL
-- ALWAYS SPAWN
--========================================================--

local function NewRoom(room)

	local roomNumber =
		GetRoomNumber(room)

	if not roomNumber then
		return
	end

	if roomNumber <= highestRoom then
		return
	end

	highestRoom = roomNumber

	print(
		"[RIPPER] New room:",
		roomNumber
	)

	task.wait(0.1)

	local char =
		LocalPlayer.Character

	local hum =
		char
		and char:FindFirstChildOfClass(
			"Humanoid"
		)

	if not hum or hum.Health <= 0 then
		return
	end

	if ripperActive then

		print(
			"[RIPPER] Already active - skipping duplicate"
		)

		return

	end

	--====================================================--
	-- ALWAYS SPAWN
	--====================================================--

	print(
		"[RIPPER] >>> NEW ROOM -> RIPPER SPAWN <<<"
	)

	task.spawn(function()

		SpawnRipper()

	end)

end

