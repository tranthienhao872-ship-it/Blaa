local function scanAndGenerateScript(airOffset)
    local buffer = {
        "-- ================================================",
        "-- SCRIPT ĐƯỢC TỰ SINH BỞI PART COPIER",
        "-- Dan doan nay vao 1 Script (Server) HOAC LocalScript (Client)",
        "-- bat ky, o bat ky noi nao (Workspace, ServerScriptService,",
        "-- StarterPlayerScripts...) - kho ca file/game moi hoan toan.",
        "-- KHONG dan vao ModuleScript (ModuleScript khong tu chay).",
        "-- ================================================",
        "",
        "-- Cho game tai xong het roi moi chay, tranh loi do dan/chay qua som",
        "-- (VD file moi vua tao, cac service chua san sang kip).",
        "if not game:IsLoaded() then",
        "    game.Loaded:Wait()",
        "end",
        "",
    }

    local index = 0
    local shapeLostCount = 0
    local uniqueId = {n = 0} -- dùng chung để đặt tên biến effect không trùng nhau trong cả script
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            index += 1
            local shapeLost = buildPartCode(obj, index, buffer, airOffset, uniqueId)
            if shapeLost then
                shapeLostCount += 1
            end
        end
    end

    table.insert(buffer, string.format('print("Da spawn lai %d part.")', index))

    return table.concat(buffer, "\n"), index, shapeLostCount
end

