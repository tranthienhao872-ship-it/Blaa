----------------------------------------------------------------
-- HÀM SERIALIZE (VIẾT GIÁ TRỊ RA DẠNG CHUỖI LUA HỢP LỆ)
----------------------------------------------------------------

local function serializeValue(value)
    local t = typeof(value)

    if t == "number" then
        return tostring(value)
    elseif t == "boolean" then
        return tostring(value)
    elseif t == "string" then
        return string.format("%q", value)
    elseif t == "Color3" then
        return string.format("Color3.new(%s, %s, %s)", value.R, value.G, value.B)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%s, %s, %s)", value.X, value.Y, value.Z)
    elseif t == "Vector2" then
        return string.format("Vector2.new(%s, %s)", value.X, value.Y)
    elseif t == "NumberRange" then
        return string.format("NumberRange.new(%s, %s)", value.Min, value.Max)
    elseif t == "NumberSequence" then
        local keys = {}
        for _, kp in ipairs(value.Keypoints) do
            table.insert(keys, string.format(
                "NumberSequenceKeypoint.new(%s, %s, %s)",
                kp.Time, kp.Value, kp.Envelope
            ))
        end
        return string.format("NumberSequence.new({%s})", table.concat(keys, ", "))
    elseif t == "ColorSequence" then
        local keys = {}
        for _, kp in ipairs(value.Keypoints) do
            table.insert(keys, string.format(
                "ColorSequenceKeypoint.new(%s, Color3.new(%s, %s, %s))",
                kp.Time, kp.Value.R, kp.Value.G, kp.Value.B
            ))
        end
        return string.format("ColorSequence.new({%s})", table.concat(keys, ", "))
    elseif t == "EnumItem" then
        -- tostring(EnumItem) tra ve dung dang "Enum.Material.Plastic" -> Lua hop le san
        return tostring(value)
    elseif t == "Content" then
        return string.format("%q", tostring(value))
    else
        -- kiểu không xác định -> bỏ qua an toàn
        return nil
    end
end

local function serializeCFrame(cf)
    local c = {cf:GetComponents()}
    return "CFrame.new(" .. table.concat(c, ", ") .. ")"
end

----------------------------------------------------------------
-- HÀM SINH CODE CHO 1 INSTANCE HIỆU ỨNG (con của part)
----------------------------------------------------------------

-- Quét ĐỆ QUY toàn bộ con/cháu của 1 part, bất kể là loại effect gì
-- (không giới hạn theo whitelist class nữa -> copy hết hết).
local function buildEffectRecursive(inst, parentVarName, buffer, uniqueId)
    local className = inst.ClassName
    if SKIP_CLASSES[className] then return end

    local okNew, testInst = pcall(function() return Instance.new(className) end)
    if okNew and testInst then
        testInst:Destroy()
    else
        -- Class không thể Instance.new (VD Terrain, Camera-only...) -> bỏ qua
        return
    end

    uniqueId.n = uniqueId.n + 1
    local id = uniqueId.n
    local varName = "fx" .. id

    -- Build code cua effect nay vao innerBuffer rieng, roi boc pcall RIENG
    -- cua chinh no -> neu effect nay loi (VD 1 property la), chi no bi bo
    -- qua, khong lam hong cac effect anh em hay effect con ben trong no.
    local innerBuffer = {}
    table.insert(innerBuffer, string.format('local %s = Instance.new("%s")', varName, className))
    table.insert(innerBuffer, string.format("%s.Parent = %s", varName, parentVarName))

    -- Rieng Sound: tinh AM LUONG THUC TE da cong don qua chuoi SoundGroup cha.
    -- Ly do: SoundGroup nam trong SoundService (ngoai pham vi quet theo Part),
    -- nen khong the tao lai duoc no -> phai "nen" do khuech dai cua SoundGroup
    -- thang vao Volume ngay tu day, neu khong am thanh se nho/mong hon ban goc.
    local effectiveVolume = nil
    if className == "Sound" then
        local okVol, vol = pcall(function() return inst.Volume end)
        effectiveVolume = (okVol and type(vol) == "number") and vol or 1
        local okGroup, group = pcall(function() return inst.SoundGroup end)
        if okGroup then
            local sg = group
            while sg do
                local okGv, gv = pcall(function() return sg.Volume end)
                if okGv and type(gv) == "number" then
                    effectiveVolume = effectiveVolume * gv
                end
                local okParent, parent = pcall(function() return sg.Parent end)
                if okParent and parent and parent:IsA("SoundGroup") then
                    sg = parent
                else
                    sg = nil
                end
            end
        end
    end

    for _, propName in ipairs(GENERIC_PROPS) do
        -- Rieng Sound: KHONG gan property "Playing"/"Volume"/"SoundGroup" o day.
        -- Playing -> da goi :Play() rieng ben duoi (tranh phat chong 2 lan).
        -- Volume -> da tinh effectiveVolume o tren (cong don ca SoundGroup).
        -- SoundGroup -> tham chieu Instance, khong the tai tao lai duoc.
        local skipForSound = className == "Sound" and (
            propName == "Playing" or propName == "Volume" or propName == "SoundGroup"
        )
        if not skipForSound then
            local ok, value = pcall(function() return inst[propName] end)
            if ok and value ~= nil then
                local serialized = serializeValue(value)
                if serialized then
                    table.insert(innerBuffer, string.format("%s.%s = %s", varName, propName, serialized))
                end
            end
        end
    end

    if effectiveVolume then
        table.insert(innerBuffer, string.format("%s.Volume = %s", varName, tostring(effectiveVolume)))
    end

    -- Rieng Sound: goi thang :Play() de dam bao phat that su, khong chi
    -- dua vao gan property Playing (co the khong kich hoat lai am thanh).
    if className == "Sound" then
        local okPlaying, wasPlaying = pcall(function() return inst.Playing end)
        local okSoundId, soundId = pcall(function() return inst.SoundId end)
        if (okPlaying and wasPlaying) or (okSoundId and soundId and soundId ~= "") then
            table.insert(innerBuffer, string.format("%s:Play()", varName))
        end
    end

    -- Đệ quy xuống các con của effect này (VD Attachment chứa Beam/Trail)
    for _, child in ipairs(inst:GetChildren()) do
        if not child:IsA("BasePart") then
            buildEffectRecursive(child, varName, innerBuffer, uniqueId)
        end
    end

    table.insert(buffer, string.format("do local okfx%d, errfx%d = pcall(function()", id, id))
    for _, line in ipairs(innerBuffer) do
        table.insert(buffer, "    " .. line)
    end
    table.insert(buffer, "end)")
    table.insert(buffer, string.format(
        'if not okfx%d then warn("Loi tao effect [%s] %s: " .. tostring(errfx%d)) end',
        id, className, varName, id
    ))
    table.insert(buffer, "end")
    table.insert(buffer, "")
end

----------------------------------------------------------------
-- HÀM DÒ SCALE CỦA MODEL CHA (Roblox Model.Scale - tính năng scale
-- rig moi: khong doi Part.Size goc, chi nhan them luc hien thi/vat ly.
-- Neu khong do cai nay, part se ra TO HON so voi cai ban thay trong
-- Studio, vi Size doc duoc luon la size GOC (chua nhan scale).
----------------------------------------------------------------

local function getEffectiveModelScale(part)
    local scale = 1
    local ancestor = part.Parent
    while ancestor do
        if ancestor:IsA("Model") then
            local applied = false
            local ok1, s1 = pcall(function() return ancestor.Scale end)
            if ok1 and type(s1) == "number" and s1 > 0 then
                scale = scale * s1
                applied = true
            end
            if not applied then
                -- Mot so phien ban Roblox chi cho lay scale qua ham GetScale()
                local ok2, s2 = pcall(function() return ancestor:GetScale() end)
                if ok2 and type(s2) == "number" and s2 > 0 then
                    scale = scale * s2
                end
            end
        end
        ancestor = ancestor.Parent
    end
    return scale
end

----------------------------------------------------------------
-- HÀM SINH CODE CHO 1 PART + HIỆU ỨNG CON CỦA NÓ
----------------------------------------------------------------

local function buildPartCode(part, index, buffer, airOffset, uniqueId)
    -- Thử tạo đúng class, nếu lỗi (VD UnionOperation không new được) thì fallback "Part"
    local originalClassName = part.ClassName
    local className = originalClassName
    local okTest, testInst = pcall(function() return Instance.new(className) end)
    local shapeLost = false
    if okTest and testInst then
        testInst:Destroy()
    else
        className = "Part"
        shapeLost = true
    end

    local modelScale = getEffectiveModelScale(part)

    -- Build code của part này vào 1 buffer riêng (innerBuffer), sau đó bọc
    -- cả khối vào pcall(function() ... end) khi ghép vào buffer chính.
    -- => nếu part/effect này bị lỗi khi chạy, chỉ nó bị bỏ qua (co warn bao),
    -- các part khac van spawn binh thuong, khong bi sap ca script.
    local innerBuffer = {}

    if shapeLost then
        -- Roblox khong cho script doc/tai tao hinh dang CSG that (VD Union),
        -- nen phai fallback thanh khoi hop don gian -> can bao ro de biet
        -- day la gioi han cua Roblox, khong phai loi script.
        table.insert(innerBuffer, string.format(
            '-- CANH BAO: part goc la "%s" (khong the tao lai bang Instance.new),' ..
            ' dung khoi hop thay the -> hinh dang se KHONG giong 100%% ban goc.',
            originalClassName
        ))
    end

    local varName = "p" .. index
    table.insert(innerBuffer, string.format('local %s = Instance.new("%s")', varName, className))

    for _, propName in ipairs(PART_PROPS) do
        local ok, value = pcall(function() return part[propName] end)
        if ok and value ~= nil then
            if propName == "Size" and typeof(value) == "Vector3" and modelScale ~= 1 then
                -- Bu tru Model.Scale: Part.Size doc duoc la size GOC, phai
                -- nhan them scale cua Model cha moi ra dung size hien thi that.
                value = value * modelScale
            end
            local serialized = serializeValue(value)
            if serialized then
                table.insert(innerBuffer, string.format("%s.%s = %s", varName, propName, serialized))
            end
        end
    end

    -- Vị trí: dùng CFrame gốc, cộng thêm offset lên trời nếu bật airOffset
    local ok, cf = pcall(function() return part.CFrame end)
    if ok then
        if airOffset and airOffset > 0 then
            cf = cf + Vector3.new(0, airOffset, 0)
        end
        table.insert(innerBuffer, string.format("%s.CFrame = %s", varName, serializeCFrame(cf)))
    end

    table.insert(innerBuffer, string.format('%s.Parent = workspace', varName))
    table.insert(innerBuffer, "")

    -- Quét TOÀN BỘ con/cháu của part (mọi cấp, mọi loại effect) -> copy hết hết
    for _, child in ipairs(part:GetChildren()) do
        if not child:IsA("BasePart") then
            buildEffectRecursive(child, varName, innerBuffer, uniqueId)
        end
    end

    -- Ghép innerBuffer vào buffer chính, bọc trong pcall để cách ly lỗi
    table.insert(buffer, string.format("do local ok%d, err%d = pcall(function()", index, index))
    for _, line in ipairs(innerBuffer) do
        table.insert(buffer, "    " .. line)
    end
    table.insert(buffer, "end)")
    table.insert(buffer, string.format(
        'if not ok%d then warn("Loi spawn part %d: " .. tostring(err%d)) end', index, index, index
    ))
    table.insert(buffer, "end")
    table.insert(buffer, "")

    return shapeLost
end

