--========================================================--
--                    CAMERA SHAKER
--========================================================--

local CameraShaker

pcall(function()
	CameraShaker = require(
		ReplicatedStorage:WaitForChild("CameraShaker")
	)
end)

local cameraShake

if CameraShaker then
	cameraShake = CameraShaker.new(
		Enum.RenderPriority.Camera.Value,

		function(shakeCf)
			local camera = workspace.CurrentCamera

			if camera then
				camera.CFrame =
					camera.CFrame * shakeCf
			end
		end
	)
end

--========================================================--
--                    START SHAKE
--========================================================--

local function startShake()

	if not cameraShake then
		return
	end

	if cameraShakeRunning then
		return
	end

	cameraShakeRunning = true

	pcall(function()
		cameraShake:Start()
	end)

	task.spawn(function()

		while cameraShakeRunning do

			if
				not currentFrostbite
				or not currentFrostbite.Parent
			then
				break
			end

			pcall(function()
				cameraShake:ShakeOnce(
					15,
					12,
					0.05,
					0.45,
					0,
					0.8
				)
			end)

			task.wait(0.5)
		end

		cameraShakeRunning = false

		pcall(function()
			cameraShake:Stop()
		end)
	end)
end

--========================================================--
--                    STOP SHAKE
--========================================================--

local function stopShake()

	cameraShakeRunning = false

	if cameraShake then
		pcall(function()
			cameraShake:Stop()
		end)
	end
end

--========================================================--
--                LARGE ROOM SOUND
--========================================================--

local function playLargeRoomSound(soundId, volume)

	local sound = Instance.new("Sound")

	sound.Name = "FrostbiteEndingSound"
	sound.SoundId = soundId
	sound.Volume = volume

	sound.RollOffMode =
		Enum.RollOffMode.InverseTapered

	sound.RollOffMaxDistance = 1000
	sound.RollOffMinDistance = 10

	local reverb =
		Instance.new("ReverbSoundEffect")

	reverb.Name = "LargeRoomReverb"
	reverb.DecayTime = 5
	reverb.Density = 0.8
	reverb.Diffusion = 0.9
	reverb.WetLevel = 0.65
	reverb.DryLevel = 0.7

	reverb.Parent = sound
	sound.Parent = workspace

	pcall(function()
		ContentProvider:PreloadAsync({sound})
	end)

	sound:Play()

	return sound
end
--========================================================--
--              CLEAN ALL FROSTBITE OBJECTS
--========================================================--

local function cleanAllFrostbite()

	if currentSound then
		pcall(function()
			currentSound.Looped = false
			currentSound:Stop()
			currentSound:Destroy()
		end)

		currentSound = nil
	end

	if currentFrostbite then
		pcall(function()
			currentFrostbite:Destroy()
		end)

		currentFrostbite = nil
	end

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj.Name == "Frostbite" then
			pcall(function()
				obj:Destroy()
			end)
		end
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Sound") then
			if
				obj.Name == "FrostbiteSound"
				or obj.Name == "FrostbiteEndingSound"
			then
				pcall(function()
					obj:Stop()
					obj:Destroy()
				end)
			end
		end
	end
end

--========================================================--
--                  ENDING SHAKE
--========================================================--

local function endingShake(duration)

	if not cameraShake then
		return
	end

	-- Không tạo loop thứ 2
	if cameraShakeRunning then
		return
	end

	cameraShakeRunning = true

	pcall(function()
		cameraShake:Start()
	end)

	local startTime = tick()

	while
		cameraShakeRunning
		and tick() - startTime < duration
	do

		pcall(function()
			cameraShake:ShakeOnce(
				15,
				12,
				0.03,
				0.35,
				0,
				0.8
			)
		end)

		task.wait(0.3)
	end

	cameraShakeRunning = false

	pcall(function()
		cameraShake:Stop()
	end)
end

--========================================================--
--                 DESTROY FROSTBITE
--========================================================--

local function destroyFrostbite()

	if endingSequenceRunning then
		return
	end

	endingSequenceRunning = true

	--====================================================--
	--                  STOP SHAKE FIRST
	--====================================================--

	stopShake()

	--====================================================--
	--                  BAR MẤT TRƯỚC
	--====================================================--

	hideBar()

	frostbiteValue = 0
	damageTimer = 0

	fill.Size =
		UDim2.new(
			1,
			0,
			0,
			0
		)

	--====================================================--
	--                  DELETE ENTITY
	--====================================================--

	cleanAllFrostbite()

	currentRoom = nil
	roomRockChanged = false

	-- Đợi bar trượt ra
	task.wait(0.5)

	--====================================================--
	--                  ENDING EFFECT
	--====================================================--

	blueFrame.BackgroundTransparency = 0.2

	vignette.Visible = true
	vignette.ImageTransparency = 0.25

	frostbiteImage.ImageTransparency = 0.35

	--====================================================--
	--                  ENDING SOUND 1
	--====================================================--

	local sound1 =
		playLargeRoomSound(
			ATTACK_SOUND_ID,
			6
		)

	--====================================================--
	--                  ENDING SOUND 2
	--====================================================--

	local sound2 =
		playLargeRoomSound(
			FINAL_SOUND_ID,
			7
		)

	--====================================================--
	--                   ENDING SHAKE
	--====================================================--

	task.spawn(function()

		local duration1 = 0
		local duration2 = 0

		pcall(function()
			duration1 = sound1.TimeLength
		end)

		pcall(function()
			duration2 = sound2.TimeLength
		end)

		local duration =
			math.max(
				duration1,
				duration2,
				2
			)

		endingShake(duration)
	end)

	--====================================================--
	--                 WAIT SOUNDS
	--====================================================--

	local finished1 = false
	local finished2 = false

	sound1.Ended:Connect(function()
		finished1 = true
	end)

	sound2.Ended:Connect(function()
		finished2 = true
	end)

	local timeout =
		tick() + 15

	while
		(not finished1 or not finished2)
		and tick() < timeout
	do

		task.wait(0.05)
	end

	--====================================================--
	--                    STOP SHAKE
	--====================================================--

	stopShake()

	--====================================================--
	--                    CLEAN SOUND
	--====================================================--

	pcall(function()
		sound1:Stop()
		sound1:Destroy()
	end)

	pcall(function()
		sound2:Stop()
		sound2:Destroy()
	end)

	--====================================================--
	--                    FINAL FADE
	--====================================================--

	local finalFadeTime = 1.5

	TweenService:Create(
		blueFrame,
		TweenInfo.new(
			finalFadeTime,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out
		),
		{
			BackgroundTransparency = 1
		}
	):Play()

	TweenService:Create(
		vignette,
		TweenInfo.new(
			finalFadeTime,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out
		),
		{
			ImageTransparency = 1
		}
	):Play()

	TweenService:Create(
		frostbiteImage,
		TweenInfo.new(
			finalFadeTime,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out
		),
		{
			ImageTransparency = 1
		}
	):Play()

	if currentLight then

		TweenService:Create(
			currentLight,
			TweenInfo.new(
				finalFadeTime,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),
			{
				Brightness = 0,
				Range = 0
			}
		):Play()
	end

	task.wait(finalFadeTime)

	removeLight()

	endingSequenceRunning = false
end

--========================================================--
--                     PREVIOUS ROOM
--========================================================--

local function getPreviousRoom(newRoom)

	local rooms = {}

	for _, room in ipairs(
		CurrentRooms:GetChildren()
	) do

		if
			room:IsA("Model")
			and room ~= newRoom
		then

			table.insert(
				rooms,
				room
			)
		end
	end

	table.sort(
		rooms,
		function(a, b)

			return
				(tonumber(a.Name) or 0)
				<
				(tonumber(b.Name) or 0)
		end
	)

	return rooms[#rooms]
end
