local function makeRoomRock()

	if
		roomRockChanged
		or not currentRoom
	then
		return
	end

	roomRockChanged = true

	for _, obj in ipairs(
		currentRoom:GetDescendants()
	) do

		if obj:IsA("BasePart") then

			obj.Material =
				Enum.Material.Rock

			obj.Color =
				Color3.fromRGB(
					154,
					209,
					255
				)
		end
	end
end

--========================================================--
--                DESTROY ROOM OBJECTS
--========================================================--

local function destroyRoomObjects(room)

	if not room then
		return
	end

	if destroyedRooms[room] then
		return
	end

	destroyedRooms[room] = true

	task.spawn(function()

		task.wait(0.05)

		local assetContainer =
			room:FindFirstChild("Assets")
			or room

		--================================================--
		--                   BREAK SOUND
		--================================================--

		local breakSound =
			Instance.new("Sound")

		breakSound.Name =
			"FrostbiteBreakSound"

		breakSound.SoundId =
			BREAK_SOUND_ID

		breakSound.Volume = 2.5
		breakSound.Parent = assetContainer

		breakSound:Play()

		breakSound.Ended:Connect(function()
			pcall(function()
				breakSound:Destroy()
			end)
		end)

		--================================================--
		--                   BREAK SOUNDS
		--================================================--

		local breakSounds = {
			"rbxassetid://9125992545",
			"rbxassetid://4004052860",
			"rbxassetid://7142857558",
			"rbxassetid://7142843615",
			"rbxassetid://7142857558",
			"rbxassetid://2612674531",
			"rbxassetid://2174790942"
		}

		local blacklist = {
			"wardrobe",
			"bed",
			"rug",
			"key",
			"drawer",
			"book",
			"breaker",
			"table",
			"desk",
			"gold",
			"dresser"
		}

		for _, item in ipairs(
			assetContainer:GetChildren()
		) do

			if
				item:IsA("Model")
				and item.Name ~= "Door"
				and item.Name ~= "HidingSpots"
			then

				local isBlacklisted = false

				local itemNameLower =
					string.lower(item.Name)

				for _, word in ipairs(
					blacklist
				) do

					if string.find(
						itemNameLower,
						word
					) then

						isBlacklisted = true
						break
					end
				end

				if not isBlacklisted then

					local primary =
						item.PrimaryPart
						or item:FindFirstChildWhichIsA(
							"BasePart"
						)

					if primary then

						task.spawn(function()

							for _, v in ipairs(
								item:GetDescendants()
							) do

								if v:IsA("BasePart") then

									local lowerName =
										string.lower(v.Name)

									if
										not string.find(
											lowerName,
											"floor"
										)
										and not string.find(
											lowerName,
											"hitbox"
										)
									then

										task.wait(
											math.random(
												1,
												4
											) / 100
										)

										local randomSoundId =
											breakSounds[
												math.random(
													1,
													#breakSounds
												)
											]

										local s =
											Instance.new("Sound")

										s.SoundId =
											randomSoundId

										s.Volume =
											math.random(
												12,
												24
											) / 10

										s.PlaybackSpeed =
											math.random(
												85,
												115
											) / 100

										s.RollOffMaxDistance =
											100

										s.Parent = v
										s:Play()

										s.Ended:Connect(
											function()
												pcall(function()
													s:Destroy()
												end)
											end
										)

										v.Anchored = false
										v.CanCollide = true

										v.CustomPhysicalProperties =
											PhysicalProperties.new(
												0.01,
												0.01,
												0.5,
												1,
												1
											)

										pcall(function()
											if v:CanSetNetworkOwnership() then
												v:SetNetworkOwner(
													player
												)
											end
										end)

										v.CFrame =
											v.CFrame
											+ Vector3.new(
												0,
												0.05,
												0
											)
									end
								end
							end
						end)

						primary.Anchored = true

						task.wait()

						primary.Anchored = false

						primary.AssemblyLinearVelocity =
							Vector3.new(
								math.random(-60, 60),
								math.random(20, 50),
								math.random(-60, 60)
							)

						primary.AssemblyAngularVelocity =
							Vector3.new(
								math.random(-25, 25),
								math.random(-25, 25),
								math.random(-25, 25)
							)
					end
				end
			end
		end
	end)
end

--========================================================--
--                    SPAWN FROSTBITE
--========================================================--

local function spawnFrostbite(room)

	if stopped then
		return
	end

	if endingSequenceRunning then
		return
	end

	if spawningFrostbite then
		return
	end

	spawningFrostbite = true

	--====================================================--
	--              DELETE OLD FROSTBITE FIRST
	--====================================================--

	stopShake()
	cleanAllFrostbite()

	task.wait(0.1)

	if stopped then
		spawningFrostbite = false
		return
	end

	if not room then
		spawningFrostbite = false
		return
	end

	local success, model =
		pcall(function()

			return game:GetObjects(
				FROSTBITE_ID
			)[1]

		end)

	if
		not success
		or not model
	then

		warn(
			"Không load được Frostbite"
		)

		spawningFrostbite = false
		return
	end

	model.Name =
		"Frostbite"

	model.Parent =
		workspace

	currentFrostbite =
		model

	currentRoom =
		room

	roomRockChanged =
		false

	frostbiteValue =
		0

	damageTimer =
		0

	fill.Size =
		UDim2.new(
			1,
			0,
			0,
			0
		)

	--====================================================--
	--                       SOUND
	--====================================================--

	local sound =
		Instance.new("Sound")

	sound.Name =
		"FrostbiteSound"

	sound.SoundId =
		SOUND_ID

	sound.Volume = 5
	sound.PlaybackSpeed = 1
	sound.Looped = true
	sound.Parent = model

	currentSound =
		sound

	pcall(function()
		ContentProvider:PreloadAsync({
			sound
		})
	end)

	sound:Play()

	--====================================================--
	--                     POSITION
	--====================================================--

	local basepart =
		model:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	local parts =
		room:FindFirstChild("Parts")

	local floor

	if parts then
		floor =
			parts:FindFirstChild("Floor")
	end

	if basepart and floor then

		basepart.CFrame =
			floor.CFrame
			+ Vector3.new(
				0,
				8,
				0
			)
	end

	--====================================================--
	--                      EFFECTS
	--====================================================--

	showBar()
	startScreenEffects()
	startShake()

	print(
		"Frostbite spawned tại phòng "
		.. room.Name
	)

	spawningFrostbite = false
end

--========================================================--
--                     BAR UPDATE
--========================================================--

barConnection =
	RunService.Heartbeat:Connect(
		function(dt)

			if endingSequenceRunning then
				return
			end

			if
				not currentFrostbite
				or not currentFrostbite.Parent
			then
				return
			end

			local character =
				player.Character

			if not character then
				return
			end

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if
				not humanoid
				or humanoid.Health <= 0
			then
				return
			end

			local lighter =
				hasLighter()
			--================================================--
			--                         BAR
			--================================================--

			if lighter then

				frostbiteValue -=
					LIGHTER_SPEED * dt

			else

				frostbiteValue +=
					GROW_SPEED * dt

			end

			frostbiteValue =
				math.clamp(
					frostbiteValue,
					0,
					100
				)

			fill.Size =
				UDim2.new(
					1,
					0,
					frostbiteValue / 100,
					0
				)

			--================================================--
			--                     VIGNETTE
			--================================================--

			local targetTransparency

			if lighter then

				targetTransparency = 1

			else

				targetTransparency =
					math.clamp(
						1 -
							(
								frostbiteValue
								/
								100
								*
								0.85
							),
						0.15,
						1
					)
			end

			vignette.Visible = true
			vignette.ZIndex = 100

			vignette.ImageTransparency +=
				(
					targetTransparency
					-
					vignette.ImageTransparency
				)
				*
				math.clamp(
					dt * 4,
					0,
					1
				)

			frostbiteImage.ImageTransparency =
				targetTransparency

			--================================================--
			--                      ROCK
			--================================================--

			if
				frostbiteValue >= 10
				and not roomRockChanged
			then

				makeRoomRock()
			end

			--================================================--
			--                     DAMAGE
			--================================================--

			if
				frostbiteValue >=
				DAMAGE_START
			then

				damageTimer += dt

				if damageTimer >= 1 then

					damageTimer -= 1

					humanoid.Health =
						math.max(
							0,
							humanoid.Health
							- DAMAGE
						)
				end

			else

				damageTimer = 0
			end
		end
	)

--========================================================--
--                     ROOM DETECTION
--========================================================--

roomConnection =
	CurrentRooms.ChildAdded:Connect(
		function(newRoom)

			if stopped then
				return
			end

			if not newRoom:IsA("Model") then
				return
			end

			task.wait(0.2)

			if stopped then
				return
			end

			doorCount += 1

			print(
				"Đã mở cửa lần: "
				.. doorCount
			)

			--================================================--
			--                  DESTROY OLD OBJECTS
			--================================================--

			local previousRoom =
				getPreviousRoom(newRoom)

			if previousRoom then
				destroyRoomObjects(previousRoom)
			end

			--================================================--
			--                     ROOM 6
			--================================================--

			if doorCount >= 6 then

				if currentFrostbite then

					task.spawn(function()
						destroyFrostbite()
					end)

				else

					hideBar()
					frostbiteValue = 0
					damageTimer = 0

					fill.Size =
						UDim2.new(
							1,
							0,
							0,
							0
						)
				end

				return
			end

			--================================================--
			--                  SPAWN FROSTBITE
			--================================================--

			if not endingSequenceRunning then
				spawnFrostbite(newRoom)
			end
		end
	)

--========================================================--
--                    CHARACTER RESET
--========================================================--

player.CharacterAdded:Connect(
	function()

		task.wait(0.5)

		if currentFrostbite then

			cleanAllFrostbite()

			stopShake()
			removeLight()

			frostbiteValue = 0
			damageTimer = 0

			fill.Size =
				UDim2.new(
					1,
					0,
					0,
					0
				)

			hideBar()
		end
	end
)

--========================================================--
--                       CLEANUP
--========================================================--

script.Destroying:Connect(
	function()

		stopped = true

		if roomConnection then
			roomConnection:Disconnect()
		end

		if barConnection then
			barConnection:Disconnect()
		end

		stopShake()
		cleanAllFrostbite()
		removeLight()

		if screenGui then
			pcall(function()
				screenGui:Destroy()
			end)
		end
	end
)

