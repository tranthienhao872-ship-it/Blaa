--========================================================--
--                       LIGHTER
--========================================================--

local function hasLighter()
	local character = player.Character

	if not character then
		return false
	end

	for _, tool in ipairs(character:GetChildren()) do
		if tool:IsA("Tool") then
			local name = string.lower(tool.Name)

			if
				name == "lighter"
				or name == "lighting"
				or string.find(name, "lighter")
				or string.find(name, "lighting")
				or string.find(name, "light")
			then

				local foundLight = false

				for _, obj in ipairs(tool:GetDescendants()) do
					if
						obj:IsA("PointLight")
						or obj:IsA("SpotLight")
						or obj:IsA("SurfaceLight")
					then
						foundLight = true

						if obj.Enabled then
							return true
						end
					end
				end

				if not foundLight then
					return true
				end
			end
		end
	end

	return false
end

