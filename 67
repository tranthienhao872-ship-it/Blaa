local typingToken = 0

local function StopTyping()

	typingToken += 1

end

local function TypeText(
	text,
	speed
)

	if not caption then
		return
	end

	typingToken += 1

	local myToken =
		typingToken

	caption.Font =
		ANTIQUE_FONT

	caption.Visible =
		true

	caption.TextTransparency =
		0

	caption.Text =
		""

	for i = 1, #text do

		if not shuold then
			return
		end

		if myToken ~= typingToken then
			return
		end

		caption.Font =
			ANTIQUE_FONT

		caption.Text =
			string.sub(
				text,
				1,
				i
			)

		caption.TextTransparency =
			0

		task.wait(
			speed or 0.04
		)

	end

end

