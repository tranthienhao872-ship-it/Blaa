local function GetRoomNumber(
	room
)

	if not room then
		return nil
	end

	return tonumber(
		room.Name
	)

end

local function GetNearestRoom(
	position
)

	local nearest =
		nil

	local shortest =
		math.huge

	for _, room in ipairs(
		currentRooms:GetChildren()
	) do

		if room:IsA("Model") then

			local success,
				cf =
				pcall(function()

					local roomCF =
						room:GetBoundingBox()

					return roomCF

				end)

			if success
				and cf then

				local distance =
					(
						cf.Position
						- position
					).Magnitude

				if distance <
					shortest then

					shortest =
						distance

					nearest =
						room

				end

			end

		end

	end

	return nearest

end
local function RunBreakScript(
	roomNumber
)

	if not shuold
