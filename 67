	end

	--====================================================--
	-- RUN DISTANCE CHECK
	--====================================================--

	task.spawn(function()

		while shuold do

			task.wait(
				0.05
			)

			if not Cayracto
				or not Cayracto.Parent
				or not basepart
				or not basepart.Parent then

				continue

			end

			local hrp =
				Cayracto:FindFirstChild(
					"HumanoidRootPart"
				)

			if not hrp then
				continue
			end

			local distance =
				(
					hrp.Position
					- basepart.Position
				).Magnitude

			if distance <
				50 then

				if not warningActive then

					warningActive =
						true

					StopTyping()

					StartRunGlitch()

				end

			else

				if warningActive then

					StopRunGlitch()

				end

			end

		end

	end)

	--====================================================--
	-- DEERGOD DURATION
	--====================================================--

	task.wait(
		DEERGOD_DURATION
	)

	--====================================================--
	-- DEERGOD DEAD / END
	--====================================================--

	breakSystemActive =
		false

	shuold =
		false

	StopTyping()
	StopRunGlitch()

	--====================================================--
	-- STOP CAMERA SHAKE
	--====================================================--

	if spawnShake then

		pcall(function()

			spawnShake:Stop()

		end)

	end

	--====================================================--
	-- DISCONNECT MOVEMENT
	--====================================================--

	if connection then

		pcall(function()

			connection:Disconnect()

		end)

		connection =
			nil

	end

	--====================================================--
	-- STOP MUSIC
	--====================================================--

	if Lord then

		pcall(function()

			Lord:Stop()
			Lord:Destroy()

		end)

		Lord =
			nil

	end

	--====================================================--
	-- REMOVE JUMPSCARE
	--====================================================--

	if screenGui then

		pcall(function()

			screenGui:Destroy()

		end)

		screenGui =
			nil

	end

	--====================================================--
	-- CLEAR CAPTION
	--====================================================--

	if caption then

		caption.Text =
			""

		caption.TextTransparency =
			1

		caption.Visible =
			false

	end

	--====================================================--
	-- REMOVE DEERGOD
	--====================================================--

	if deergod then

		pcall(function()

			deergod:Destroy()

		end)

	end

	deergod =
		nil

	basepart =
		nil

	--====================================================--
	-- ENDING SCREEN
	--====================================================--

	local endingGui =
		Instance.new(
			"ScreenGui"
		)

	endingGui.Name =
		"DeerGodEndingFade"

	endingGui.IgnoreGuiInset =
		true

	endingGui.ResetOnSpawn =
		false

	endingGui.DisplayOrder =
		2147483647

	endingGui.ZIndexBehavior =
		Enum.ZIndexBehavior.Sibling

	endingGui.Parent =
		playerGui

	--====================================================--
	-- SOFT BLACK FRAME
	--====================================================--

	local blackFrame =
		Instance.new(
			"Frame"
		)

	blackFrame.Name =
		"SoftBlack"

	blackFrame.AnchorPoint =
		Vector2.new(
			0.5,
			0.5
		)

	blackFrame.Position =
		UDim2.fromScale(
			0.5,
			0.5
		)

	blackFrame.Size =
		UDim2.fromScale(
			1,
			1
		)

	blackFrame.BackgroundColor3 =
		Color3.fromRGB(
			0,
			0,
			0
		)

	blackFrame.BorderSizePixel =
		0

	-- Ban đầu trong suốt
	blackFrame.BackgroundTransparency =
		1

	blackFrame.ZIndex =
		999999

	blackFrame.Parent =
		endingGui

	--====================================================--
	-- FADE → ĐEN MỜ
	--====================================================--

	local fadeIn =
		TweenService:Create(

			blackFrame,

			TweenInfo.new(

				END_FADE_TIME,

				Enum.EasingStyle.Sine,

				Enum.EasingDirection.InOut

			),

			{
				BackgroundTransparency =
					ENDING_DARKNESS
			}

		)

	fadeIn:Play()

	-- Chờ fade hoàn thành
	fadeIn.Completed:Wait()

	--====================================================--
	-- PLAY END SOUND
	--====================================================--

	local endSound =
		Instance.new(
			"Sound"
		)

	endSound.Name =
		"DeerGodEndingSound"

	endSound.SoundId =
		END_SOUND

	endSound.Volume =
		5

	endSound.Looped =
		false

	endSound.Parent =
		endingGui

	-- Phát sound
	endSound:Play()

	--====================================================--
	-- WAIT UNTIL SOUND REALLY ENDS
	--====================================================--

	local soundFinished =
		false

	local soundConnection

	soundConnection =
		endSound.Ended:Connect(function()

			soundFinished =
				true

		end)

	while not soundFinished do

		task.wait(
			0.05
		)

	end

	if soundConnection then

		soundConnection:Disconnect()

		soundConnection =
			nil

	end

	--====================================================--
	-- SOUND HẾT
	-- FADE MÀN HÌNH VỀ BÌNH THƯỜNG
	--====================================================--

	local fadeOut =
		TweenService:Create(

			blackFrame,

			TweenInfo.new(

				END_FADE_TIME,

				Enum.EasingStyle.Sine,

				Enum.EasingDirection.InOut

			),

			{
				BackgroundTransparency =
					1
			}

		)

	fadeOut:Play()

	-- Chờ fade sáng hoàn toàn
	fadeOut.Completed:Wait()

	--====================================================--
	-- CLEAN EVERYTHING
	--====================================================--

	blackFrame.BackgroundTransparency =
		1

	pcall(function()

		endSound:Stop()
		endSound:Destroy()

	end)

	pcall(function()

		endingGui:Destroy()

	end)

	--====================================================--
	-- SCRIPT FINISHED
	--====================================================--

end
